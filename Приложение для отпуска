export default function TravelChecklistPrototype() {
  const [tab, setTab] = useState("new");

  const [crew, setCrew] = useState("both");
  const [mode, setMode] = useState("sea_summer");
  const [days, setDays] = useState(7);
  const [tripName, setTripName] = useState("Море");

  const [blocks, setBlocks] = useState(() => makeItemsFromTemplate("sea_summer", "both"));

  const [filtersOpen, setFiltersOpen] = useState(false);
  const [showOnlyCritical, setShowOnlyCritical] = useState(false);
  const [showOnlyMine, setShowOnlyMine] = useState(false);
  const [search, setSearch] = useState("");

  const effectiveOwnerFilter = useMemo(() => {
    if (!showOnlyMine) return null;
    if (crew === "both") return null;
    return crew;
  }, [showOnlyMine, crew]);

  const flatItems = useMemo(() => blocks.flatMap((b) => b.items.map((it) => ({ ...it, _section: b.title }))), [blocks]);
  const doneCount = useMemo(() => flatItems.filter((i) => i.done).length, [flatItems]);
  const totalCount = flatItems.length;
  const progress = totalCount ? (doneCount / totalCount) * 100 : 0;

  const filteredBlocks = useMemo(() => {
    const q = search.trim().toLowerCase();
    return blocks
      .map((b) => {
        let items = b.items;
        if (showOnlyCritical) items = items.filter((it) => it.critical === "важно");
        if (effectiveOwnerFilter) items = items.filter((it) => it.owner === effectiveOwnerFilter);
        if (q) items = items.filter((it) => it.name.toLowerCase().includes(q));
        return { ...b, items };
      })
      .filter((b) => b.items.length > 0);
  }, [blocks, search, showOnlyCritical, effectiveOwnerFilter]);

  const currentModeMeta = useMemo(() => MODES.find((m) => m.id === mode) || MODES[0], [mode]);

  function startTrip(nextModeId = mode, nextCrew = crew) {
    setBlocks(makeItemsFromTemplate(nextModeId, nextCrew));
    setTab("check");
  }

  function toggleItem(itemId) {
    setBlocks((prev) =>
      prev.map((b) => ({
        ...b,
        items: b.items.map((it) => (it.id === itemId ? { ...it, done: !it.done } : it)),
      }))
    );
  }

  return (
    <>
      <AppShell>
        {tab === "new" ? (
          <div>
            <TopBar
              title="Packing"
              right={
                <GhostIconButton label="Settings" onClick={() => setFiltersOpen(true)}>
                  <Settings className="h-5 w-5" />
                </GhostIconButton>
              }
            />

            <SectionHeader title="Новая поездка" subtitle="Выберите состав и сценарий. Список соберётся сам." right={<ProgressRing value={progress} />} />

            <div className="mt-4 flex gap-2 overflow-auto pb-1">
              {CREW.map((c) => (
                <Pill
                  key={c.id}
                  active={crew === c.id}
                  onClick={() => {
                    setCrew(c.id);
                    setBlocks(makeItemsFromTemplate(mode, c.id));
                  }}
                  icon={c.id === "both" ? Users : null}
                >
                  {c.label}
                </Pill>
              ))}
            </div>

            <Card className="mt-4 p-4">
              <div className="mb-3 flex items-center justify-between">
                <div className="text-xs font-semibold text-slate-600">Шаг 1 из 2</div>
                <div className="text-xs text-slate-500">Состав и срок</div>
              </div>
              <div className="text-sm font-semibold text-slate-900">Длительность</div>
              <div className="mt-2 flex items-center gap-3">
                <button type="button" className="rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm" onClick={() => setDays((d) => clamp(d - 1, 1, 45))}>
                  −
                </button>
                <div className="flex-1 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-900">{days} дней</div>
                <button type="button" className="rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm" onClick={() => setDays((d) => clamp(d + 1, 1, 45))}>
                  +
                </button>
              </div>
              <div className="mt-3 text-xs text-slate-600">Используется для подсказок (позже: количество одежды и расходников).</div>
            </Card>

            <div className="mt-4">
              <div className="mb-2 text-sm font-semibold text-white/95">Сценарий</div>
              <div className="grid grid-cols-1 gap-3">
                {MODES.map((m) => {
                  const Icon = m.icon;
                  const active = m.id === mode;
                  return (
                    <motion.button
                      key={m.id}
                      layout
                      type="button"
                      onClick={() => {
                        setMode(m.id);
                        setTripName(m.title);
                        setBlocks(makeItemsFromTemplate(m.id, crew));
                      }}
                      className={
                        "relative overflow-hidden rounded-3xl border p-4 text-left transition shadow-[0_10px_30px_rgba(0,0,0,0.10)] " +
                        (active ? "border-[#C62433]" : "border-white/45 hover:border-white/65")
                      }
                    >
                      <div className={`absolute inset-0 bg-gradient-to-b ${m.tone} opacity-70`} />
                      <div className="relative flex items-start gap-3">
                        <div className={"rounded-2xl border bg-white/80 p-2 shadow-sm " + (active ? "border-[#C62433]" : "border-white/60")}>
                          <Icon className="h-5 w-5 text-slate-900" />
                        </div>
                        <div className="min-w-0 flex-1">
                          <div className="text-base font-semibold tracking-tight text-slate-900">{m.title}</div>
                          <div className="mt-1 text-sm text-slate-700 leading-snug">{m.blurb}</div>
                        </div>
                        <div className="pt-1 text-slate-500">
                          <ArrowRight className="h-5 w-5" />
                        </div>
                      </div>
                    </motion.button>
                  );
                })}
              </div>
            </div>

            <div className="mt-5">
              <button
                type="button"
                onClick={() => startTrip(mode, crew)}
                className="w-full rounded-3xl bg-[#C62433] px-5 py-4 text-sm font-semibold text-white shadow-[0_12px_30px_rgba(198,36,51,0.25)] hover:brightness-95"
              >
                Начать сборы
              </button>
              <div className="mt-2 text-center text-xs text-white/80">Сервис офлайн, без аккаунтов. Два человека — один порядок.</div>
            </div>
          </div>
        ) : null}

        {tab === "check" ? (
          <div>
            <TopBar
              title={tripName || "Сборы"}
              left={
                <GhostIconButton label="Back" onClick={() => setTab("new")}>
                  <ChevronLeft className="h-5 w-5" />
                </GhostIconButton>
              }
              right={
                <GhostIconButton label="Filter" onClick={() => setFiltersOpen(true)}>
                  <Filter className="h-5 w-5" />
                </GhostIconButton>
              }
            />

            <Card className="p-4">
              <div className="mb-3 flex items-center justify-between">
                <div className="text-xs font-semibold text-slate-600">Сборы</div>
                <div className="text-xs text-slate-500">Фильтры и поиск</div>
              </div>
              <div className="flex items-start justify-between gap-3">
                <div>
                  <div className="text-sm font-semibold text-slate-900">Прогресс сборов</div>
                  <div className="mt-1 text-xs text-slate-700">
                    {CREW.find((c) => c.id === crew)?.label} · {currentModeMeta.title} · {days} дней
                  </div>
                </div>
                <ProgressRing value={progress} />
              </div>

              <div className="mt-4 flex items-center gap-2 rounded-[22px] border border-slate-200 bg-white px-3 py-2 shadow-sm">
                <Search className="h-4 w-4 text-slate-400" />
                <input
                  value={search}
                  onChange={(e) => setSearch(e.target.value)}
                  placeholder="Поиск по вещам"
                  className="w-full bg-transparent text-sm text-slate-900 placeholder:text-slate-400 outline-none"
                />
              </div>

              <div className="mt-3 flex gap-2 overflow-auto pb-1">
                <Pill active={!showOnlyCritical} onClick={() => setShowOnlyCritical(false)}>
                  Всё
                </Pill>
                <Pill active={showOnlyCritical} onClick={() => setShowOnlyCritical(true)}>
                  Только важное
                </Pill>
                <Pill active={showOnlyMine} onClick={() => setShowOnlyMine((v) => !v)}>
                  Моё
                </Pill>
              </div>
            </Card>

            <div className="mt-4 space-y-4">
            <FloatingAction onClick={() => setFiltersOpen(true)} label="Фильтры" Icon={Filter} />
              {filteredBlocks.map((b) => (
                <div key={`${b.owner}-${b.title}`}>
                  <div className="mb-2 flex items-center justify-between">
                    <div className="flex items-center gap-2">
                      <OwnerBadge owner={b.owner} />
                      <div className="text-sm font-semibold text-white">{b.title}</div>
                    </div>
                    <div className="text-xs text-white/80">
                      {b.items.filter((i) => i.done).length}/{b.items.length}
                    </div>
                  </div>
                  <div className="space-y-2">
                    {b.items.map((it) => (
                      <ChecklistItem key={it.id} item={it} onToggle={() => toggleItem(it.id)} />
                    ))}
                  </div>
                </div>
              ))}

              {filteredBlocks.length === 0 ? (
                <div className="rounded-3xl border border-white/40 bg-white/70 p-6 text-center text-sm text-slate-700 shadow-sm">
                  Ничего не найдено.
                </div>
              ) : null}
            </div>
          </div>
        ) : null}

        {tab === "history" ? (
          <div>
            <TopBar
              title="История"
              right={
                <GhostIconButton label="Settings" onClick={() => setFiltersOpen(true)}>
                  <Settings className="h-5 w-5" />
                </GhostIconButton>
              }
            />

            <SectionHeader
              title="Последние поездки"
              subtitle="Демо. В реальном приложении — сохранение в localStorage и быстрый повтор."
            />

            <div className="mt-4 space-y-3">
              {["Зима · Лыжи · Лера + Илья", "Лето · Море · Лера + Илья", "Командировка · Зима · Илья"].map((t, idx) => (
                <button
                  key={t}
                  type="button"
                  onClick={() => {
                    if (idx === 0) {
                      setMode("ski_winter");
                      setCrew("both");
                      setTripName("Зима · Лыжи");
                      setBlocks(makeItemsFromTemplate("ski_winter", "both"));
                      setTab("check");
                    } else {
                      setMode("sea_summer");
                      setCrew("both");
                      setTripName("Лето · Море");
                      setBlocks(makeItemsFromTemplate("sea_summer", "both"));
                      setTab("check");
                    }
                  }}
                  className="w-full rounded-3xl border border-white/45 bg-white/70 p-4 text-left shadow-sm hover:bg-white/80"
                >
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <div className="text-sm font-semibold text-slate-900">{t}</div>
                      <div className="mt-1 text-xs text-slate-600">Повторить как шаблон</div>
                    </div>
                    <ArrowRight className="h-5 w-5 text-slate-500" />
                  </div>
                </button>
              ))}
            </div>
          </div>
        ) : null}

        <Modal open={filtersOpen} onClose={() => setFiltersOpen(false)} title="Настройки прототипа">
          <div className="space-y-3">
            <Toggle value={showOnlyCritical} onChange={setShowOnlyCritical} labelLeft="Всё" labelRight="Важное" />
            <Toggle value={showOnlyMine} onChange={setShowOnlyMine} labelLeft="Все" labelRight="Моё" />

            <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
              <div className="text-sm font-semibold text-slate-900">О дизайне</div>
              <div className="mt-2 text-xs text-slate-600 leading-relaxed">Mobile-first. Сдержанная эстетика: море, белая поверхность, красный акцент.</div>
            </div>

            <button
              type="button"
              onClick={() => {
                setSearch("");
                setShowOnlyCritical(false);
                setShowOnlyMine(false);
                setFiltersOpen(false);
              }}
              className="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-900 shadow-sm hover:bg-slate-50"
            >
              Сбросить фильтры
            </button>
          </div>
        </Modal>
      </AppShell>

      <BottomNav tab={tab} setTab={setTab} />
    </>
  );
}
