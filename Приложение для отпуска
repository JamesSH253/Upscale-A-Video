function clamp(n, a, b) {
  return Math.max(a, Math.min(b, n));
}

function AppShell({ children }) {
  return (
    <div className="relative min-h-screen bg-gradient-to-b from-[#0375B4] via-[#0B6D8F] to-[#EBEFF2]">
      <div className="pointer-events-none absolute inset-0 overflow-hidden">
        <div className="absolute -top-24 left-1/2 h-[420px] w-[520px] -translate-x-1/2 rounded-[999px] bg-white/18 blur-3xl" />
        <div className="absolute top-40 -left-24 h-[360px] w-[420px] rounded-[999px] bg-white/12 blur-3xl" />
        <div className="absolute top-56 -right-24 h-[380px] w-[440px] rounded-[999px] bg-white/10 blur-3xl" />
      </div>
      <div className="relative mx-auto max-w-md px-4 pb-28 pt-6">{children}</div>
    </div>
  );
}



function makeItemsFromTemplate(modeId, crewId) {
  const t = TEMPLATE[modeId] || TEMPLATE.sea_summer;
  const blocks = [];

  const pushBlock = (owner, title, items) => {
    blocks.push({
      owner,
      title,
      items: items.map((name) => ({
        id: `${owner}-${title}-${name}`,
        name,
        owner,
        done: false,
        critical: owner === "common" ? "важно" : "комфорт",
        bag: "checked",
      })),
    });
  };

  Object.entries(t.common || {}).forEach(([title, items]) => pushBlock("common", title, items));
  if (crewId === "ilya" || crewId === "both") Object.entries(t.ilya || {}).forEach(([title, items]) => pushBlock("ilya", title, items));
  if (crewId === "lera" || crewId === "both") Object.entries(t.lera || {}).forEach(([title, items]) => pushBlock("lera", title, items));

  return blocks;
}

