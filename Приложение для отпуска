    ilya: { label: "Илья", cls: "bg-white text-slate-900 border border-slate-200" },
  };
  const m = map[owner] || map.common;
  return <span className={`rounded-full px-2.5 py-1 text-[11px] font-medium ${m.cls}`}>{m.label}</span>;
}

